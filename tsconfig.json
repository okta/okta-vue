{
  "compilerOptions": {
    "module": "es6",
    "target": "es5",
    // "bundler" rather than "node": the @okta/okta-client-javascript packages expose their types
    // through `exports` subpath maps (e.g. `@okta/spa-platform` re-exports
    // `@okta/auth-foundation/core`), which legacy node resolution cannot see.
    "moduleResolution": "bundler",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ],
    "alwaysStrict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": true,
    "declarationDir": "dist/bundles/types",
    "types": [
      "vue-router", 
      "vue", 
      "jest",
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "tests/specs/**/*"
  ]
}